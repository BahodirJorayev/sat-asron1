// OnePrep Community & Messaging Database Schema (Prisma / PostgreSQL Reference)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ChatType {
  DIRECT
  SAVED_MESSAGES
  PUBLIC_GROUP
  PRIVATE_GROUP
  PUBLIC_CHANNEL
  PRIVATE_CHANNEL
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum Role {
  STUDENT
  ADMIN
}

enum PlanTier {
  FREE
  STANDARD
  PRO
  VIP
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  username           String              @unique
  fullName           String
  phoneNumber        String?
  avatarUrl          String?
  bio                String?
  role               Role                @default(STUDENT)
  planTier           PlanTier            @default(FREE)
  targetScore        Int                 @default(1500)
  streakDays         Int                 @default(0)
  xpPoints           Int                 @default(0)
  isOnline           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  createdChats       Chat[]              @relation("CreatedChats")
  memberships        ChatMember[]
  messages           Message[]
  hostedLiveStreams  LiveStreamSession[]
  arenaParticipants  ArenaParticipant[]
  roadmap            UserRoadmap?
}

model UserRoadmap {
  id              String                @id @default(uuid())
  userId          String                @unique
  planTier        PlanTier              @default(STANDARD)
  isAutoGenerated Boolean               @default(false) // false for Standard, true for Pro/VIP
  assignedMentorId String?
  startDate       DateTime              @default(now())
  targetExamDate  DateTime
  currentDay      Int                   @default(1)
  completionRate  Float                 @default(0.0) // 0.0 to 100.0%
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tasks           RoadmapTaskProgress[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapTaskProgress {
  id              String         @id @default(uuid())
  roadmapId       String
  dayNumber       Int            // 1 to 30
  taskType        String         // CONCEPT_READING, PRACTICE_SET, VOCAB, FULL_MOCK, CUSTOM
  title           String
  targetUrl       String?        // Link to SQB, Mock, or Vocab hub
  isCompleted     Boolean        @default(false)
  completedAt     DateTime?

  roadmap         UserRoadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, dayNumber, taskType])
}

model MasterCurriculumDay {
  id              Int            @id @default(autoincrement())
  dayNumber       Int            @unique // 1 to 30
  weekNumber      Int            // 1 to 4
  title           String
  domainFocus     String
  conceptMarkdown String?        @db.Text
  practiceSetIds  String[]       // Question Bank UUIDs
  vocabWordIds    String[]       // Vocab Word UUIDs
  isMockDay       Boolean        @default(false)
}

enum ArenaMode {
  QUICK_DUEL
  GROUP_ROOM
  SURVIVAL
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ArenaMatch {
  id              String             @id @default(uuid())
  roomCode        String?            @unique
  mode            ArenaMode          @default(QUICK_DUEL)
  category        String             @default("MIXED")
  status          MatchStatus        @default(WAITING)
  questionIds     String[]           // Array of 5-10 Question UUIDs
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())

  participants    ArenaParticipant[]
}

model ArenaParticipant {
  id              String         @id @default(uuid())
  matchId         String
  userId          String
  score           Int            @default(0)
  answers         Json           // [{"qIndex": 0, "answer": "B", "isCorrect": true, "timeMs": 4200}]
  isWinner        Boolean        @default(false)
  ratingDelta     Int            @default(0)

  match           ArenaMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Chat {
  id              String              @id @default(uuid())
  name            String?
  type            ChatType            @default(DIRECT)
  description     String?
  avatarUrl       String?
  inviteCode      String?             @unique
  isArchived      Boolean             @default(false)
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy       User                @relation("CreatedChats", fields: [createdById], references: [id])
  members         ChatMember[]
  messages        Message[]
  liveStreams     LiveStreamSession[]
}

model ChatMember {
  id              String              @id @default(uuid())
  chatId          String
  userId          String
  role            MemberRole          @default(MEMBER)
  isMuted         Boolean             @default(false)
  joinedAt        DateTime            @default(now())

  chat            Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id                 String              @id @default(uuid())
  chatId             String
  senderId           String
  content            String?
  mediaUrl           String?
  mediaName          String?
  mediaType          String?
  voiceAudioUrl      String?
  voiceDuration      Int?
  recordingVideoUrl  String?
  recordingTitle     String?
  recordingDuration  Int?
  attachedQuestionId String?
  isPinned           Boolean             @default(false)
  replyToMessageId   String?
  reactions          Json?
  createdAt          DateTime            @default(now())

  chat               Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender             User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model LiveStreamSession {
  id                 String              @id @default(uuid())
  chatId             String
  hostId             String
  title              String
  description        String?
  isActive           Boolean             @default(true)
  viewerCount        Int                 @default(0)
  recordingUrl       String?
  recordingDuration  Int?
  startedAt          DateTime            @default(now())
  endedAt            DateTime?

  chat               Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  host               User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
}
